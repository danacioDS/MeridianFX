"""
Macro Transformer — Transforma datos FRED en contexto macro estructurado.
"""

from typing import Dict, Any, Optional
from datetime import datetime
import logging

logger = logging.getLogger(__name__)


class MacroTransformer:
    """
    Transforma datos FRED en un contexto macro estructurado
    para el Decision Context.
    """
    
    def transform(self, raw_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Transforma datos FRED en contexto macro.
        
        Args:
            raw_data: Datos de FRED (de FredDataSource)
            
        Returns:
            Contexto macro estructurado
        """
        series = raw_data.get("series", {})
        summary = raw_data.get("summary", {})
        
        return {
            "timestamp": raw_data.get("timestamp"),
            "source": raw_data.get("source", "FRED"),
            "summary": summary,
            "series": {
                "fed_funds": self._extract_series(series, "FEDFUNDS"),
                "cpi": self._extract_series(series, "CPIAUCSL"),
                "unemployment": self._extract_series(series, "UNRATE"),
                "gdp": self._extract_series(series, "GDPC1"),
                "yield_10y": self._extract_series(series, "DGS10"),
                "yield_2y": self._extract_series(series, "DGS2"),
                "yield_spread": self._extract_series(series, "T10Y2Y"),
                "consumer_sentiment": self._extract_series(series, "UMCSENT"),
                "core_cpi": self._extract_series(series, "CORESTICKM159SFRBATL"),
                "payrolls": self._extract_series(series, "PAYEMS"),
            },
            "indicators": self._generate_indicators(summary),
            "fx_relevance": self._calculate_fx_relevance(summary)
        }
    
    def _extract_series(self, series_data: Dict, series_id: str) -> Optional[Dict]:
        """Extrae una serie específica."""
        if series_id not in series_data:
            return None
        
        data = series_data[series_id]
        return {
            "latest_value": data.get("latest", {}).get("value"),
            "latest_date": data.get("latest", {}).get("date"),
            "previous_value": data.get("previous", {}).get("value") if data.get("previous") else None,
            "source": data.get("source", "FRED"),
            "warning": data.get("warning"),
            "series_info": {
                "name": data.get("series", {}).name if data.get("series") else series_id,
                "unit": data.get("series", {}).unit if data.get("series") else "",
            }
        }
    
    def _generate_indicators(self, summary: Dict) -> Dict[str, Any]:
        """Genera indicadores derivados."""
        indicators = {}
        
        # Diferencial real de tasas (implícito)
        if summary.get("fed_funds") and summary.get("inflation"):
            indicators["real_rate"] = round(summary["fed_funds"] - summary["inflation"], 2)
        
        # Señal de política monetaria
        if summary.get("fed_funds"):
            if summary["fed_funds"] > 4.0:
                indicators["monetary_stance"] = "RESTRICTIVE"
            elif summary["fed_funds"] > 2.0:
                indicators["monetary_stance"] = "NEUTRAL"
            else:
                indicators["monetary_stance"] = "ACCOMMODATIVE"
        
        # Señal de crecimiento
        if summary.get("gdp_growth"):
            if summary["gdp_growth"] > 2.0:
                indicators["growth_signal"] = "STRONG"
            elif summary["gdp_growth"] > 0.0:
                indicators["growth_signal"] = "MODERATE"
            else:
                indicators["growth_signal"] = "WEAK"
        
        # Señal de inflación
        if summary.get("inflation"):
            if summary["inflation"] > 4.0:
                indicators["inflation_signal"] = "HIGH"
            elif summary["inflation"] > 2.0:
                indicators["inflation_signal"] = "ELEVATED"
            else:
                indicators["inflation_signal"] = "LOW"
        
        return indicators
    
    def _calculate_fx_relevance(self, summary: Dict) -> str:
        """
        Calcula la relevancia del contexto macro para FX.
        
        Returns:
            "HIGH", "MEDIUM", o "LOW"
        """
        relevance_score = 0
        
        # Fed Funds: alta relevancia
        if summary.get("fed_funds"):
            relevance_score += 2
        
        # Yield spread: alta relevancia
        if summary.get("yield_spread"):
            relevance_score += 2
        
        # Inflation: relevancia media
        if summary.get("inflation"):
            relevance_score += 1
        
        # GDP growth: relevancia media
        if summary.get("gdp_growth"):
            relevance_score += 1
        
        if relevance_score >= 5:
            return "HIGH"
        elif relevance_score >= 3:
            return "MEDIUM"
        else:
            return "LOW"

    def to_regime(self, macro_data: dict) -> dict:
        """Convierte datos macro a régimen (risk, policy, growth, inflation)."""
        # Extraer indicadores
        fed_funds = macro_data.get('fed_funds', 4.5)
        inflation = macro_data.get('inflation', 3.0)
        gdp_growth = macro_data.get('gdp_growth', 2.0)
        unemployment = macro_data.get('unemployment', 4.0)
        
        # Determinar régimen de riesgo
        if fed_funds > 5.0:
            risk = "RESTRICTIVE"
        elif fed_funds < 3.0:
            risk = "ACCOMMODATIVE"
        else:
            risk = "MODERATE"
        
        # Determinar régimen de política
        if fed_funds > 4.5:
            policy = "RESTRICTIVE"
        elif fed_funds < 3.5:
            policy = "ACCOMMODATIVE"
        else:
            policy = "NEUTRAL"
        
        # Determinar régimen de crecimiento
        if gdp_growth > 3.0:
            growth = "STRONG"
        elif gdp_growth > 1.5:
            growth = "STABLE"
        else:
            growth = "WEAK"
        
        # Determinar régimen de inflación
        if inflation > 4.0:
            inflation_regime = "HIGH"
        elif inflation > 2.5:
            inflation_regime = "MODERATE"
        else:
            inflation_regime = "LOW"
        
        return {
            'risk': risk,
            'policy': policy,
            'growth': growth,
            'inflation': inflation_regime
        }
